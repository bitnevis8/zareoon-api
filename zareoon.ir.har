            "text": "{\"success\":true,\"data\":[{\"id\":10176,\"parentId\":10175,\"name\":\"مواد شیمیایی کشاورزی\",\"englishName\":\"Agricultural Chemicals\",\"arabicName\":\"الكيماويات الزراعية\",\"russianName\":\"Агрохимикаты\",\"turkishName\":\"Tarım Kimyasalları\",\"finnishName\":\"Maatalouskemikaalit\",\"urduName\":\"زرعی کیمیکلز\",\"slug\":\"agricultural-chemicals\",\"imageUrl\":\"/images/categories/agricultural-chemicals.webp\",\"icon\":\"flask-conical\",\"unit\":\"kg\",\"isOrderable\":false,\"isActive\":true,\"sortOrder\":1,\"homepageSortOrder\":null,\"level\":2,\"isLeaf\":false,\"translations\":{\"ar\":{\"name\":\"الكيماويات الزراعية\",\"metaTitle\":\"سوق الكيماويات الزراعية بالجملة\",\"metaDescription\":\"سوق دولي للأعمال بين الشركات لتجارة الكيماويات الزراعية بالجملة، يربط الموردين والمصنعين والمصدرين والمستوردين والمشترين.\"},\"en\":{\"name\":\"Agricultural Chemicals\",\"metaTitle\":\"Agricultural Chemicals Wholesale Marketplace\",\"metaDescription\":\"International B2B wholesale marketplace for Agricultural Chemicals, connecting verified suppliers, manufacturers, exporters, importers and buyers.\"},\"fa\":{\"name\":\"مواد شیمیایی کشاورزی\",\"metaTitle\":\"خرید و فروش عمده مواد شیمیایی کشاورزی\",\"metaDescription\":\"بازار بین‌المللی B2B برای خرید و فروش عمده مواد شیمیایی کشاورزی؛ ویژه تأمین‌کنندگان، تولیدکنندگان، صادرکنندگان، واردکنندگان و خریداران.\"},\"fi\":{\"name\":\"Maatalouskemikaalit\",\"metaTitle\":\"Maatalouskemikaalit – tukkukauppa\",\"metaDescription\":\"Kansainvälinen B2B-tukkumarkkinapaikka tuoteryhmälle ”Maatalouskemikaalit”, joka yhdistää toimittajat, valmistajat, viejät, maahantuojat ja ostajat.\"},\"ru\":{\"name\":\"Агрохимикаты\",\"metaTitle\":\"Агрохимикаты — оптовая торговля\",\"metaDescription\":\"Международная B2B-площадка для оптовой торговли в категории «Агрохимикаты», объединяющая поставщиков, производителей, экспортёров, импортёров и покупателей.\"},\"tr\":{\"name\":\"Tarım Kimyasalları\",\"metaTitle\":\"Toptan Tarım Kimyasalları Pazarı\",\"metaDescription\":\"Tedarikçileri, üreticileri, ihracatçıları, ithalatçıları ve alıcıları buluşturan Tarım Kimyasalları kategorisine yönelik uluslararası B2B toptan ticaret…\"},\"ur\":{\"name\":\"زرعی کیمیکلز\",\"metaTitle\":\"زرعی کیمیکلز کی تھوک مارکیٹ\",\"metaDescription\":\"زرعی کیمیکلز کی تھوک تجارت کے لیے بین الاقوامی B2B مارکیٹ پلیس، جو سپلائرز، مینوفیکچررز، برآمد کنندگان، درآمد کنندگان اور خریداروں کو جوڑتی ہے۔\"}}},{\"id\":10182,\"parentId\":10175,\"name\":\"محصولات آلومینیومی\",\"englishName\":\"Aluminum Products\",\"arabicName\":\"منتجات الألومنيوم\",\"russianName\":\"Алюминиевая продукция\",\"turkishName\":\"Alüminyum Ürünleri\",\"finnishName\":\"Alumiinituotteet\",\"urduName\":\"ایلومینیم مصنوعات\",\"slug\":\"aluminum-products\",\"imageUrl\":\"/images/categories/aluminum.webp\",\"icon\":\"layers\",\"unit\":\"kg\",\"isOrderable\":false,\"isActive\":true,\"sortOrder\":2,\"homepageSortOrder\":null,\"level\":2,\"isLeaf\":false,\"translations\":{\"ar\":{\"name\":\"منتجات الألومنيوم\",\"metaTitle\":\"سوق منتجات الألومنيوم بالجملة\",\"metaDescription\":\"سوق دولي للأعمال بين الشركات لتجارة منتجات الألومنيوم بالجملة، يربط الموردين والمصنعين والمصدرين والمستوردين والمشترين.\"},\"en\":{\"name\":\"Aluminum Products\",\"metaTitle\":\"Aluminum Products Wholesale Marketplace\",\"metaDescription\":\"International B2B wholesale marketplace for Aluminum Products, connecting verified suppliers, manufacturers, exporters, importers and buyers.\"},\"fa\":{\"name\":\"محصولات آلومینیومی\",\"metaTitle\":\"خرید و فروش عمده محصولات آلومینیومی\",\"metaDescription\":\"بازار بین‌المللی B2B برای خرید و فروش عمده محصولات آلومینیومی؛ ویژه تأمین‌کنندگان، تولیدکنندگان، صادرکنندگان، واردکنندگان و خریداران.\"},\"fi\":{\"name\":\"Alumiinituotteet\",\"metaTitle\":\"Alumiinituotteet – tukkukauppa\",\"metaDescription\":\"Kansainvälinen B2B-tukkumarkkinapaikka tuoteryhmälle ”Alumiinituotteet”, joka yhdistää toimittajat, valmistajat, viejät, maahantuojat ja ostajat.\"},\"ru\":{\"name\":\"Алюминиевая продукция\",\"metaTitle\":\"Алюминиевая продукция — оптовая торговля\",\"metaDescription\":\"Международная B2B-площадка для оптовой торговли в категории «Алюминиевая продукция», объединяющая поставщиков, производителей, экспортёров, импортёров и…\"},\"tr\":{\"name\":\"Alüminyum Ürünleri\",\"metaTitle\":\"Toptan Alüminyum Ürünleri Pazarı\",\"metaDescription\":\"Tedarikçileri, üreticileri, ihracatçıları, ithalatçıları ve alıcıları buluşturan Alüminyum Ürünleri kategorisine yönelik uluslararası B2B toptan ticaret…\"},\"ur\":{\"name\":\"ایلومینیم مصنوعات\",\"metaTitle\":\"ایلومینیم مصنوعات کی تھوک مارکیٹ\",\"metaDescription\":\"ایلومینیم مصنوعات کی تھوک تجارت کے لیے بین الاقوامی B2B مارکیٹ پلیس، جو سپلائرز، مینوفیکچررز، برآمد کنندگان، درآمد کنندگان اور خریداروں کو جوڑتی ہے۔\"}}},{\"id\":10191,\"parentId\":10175,\"name\":\"محصولات آهن و فولاد\",\"englishName\":\"Iron & Steel Products\",\"arabicName\":\"منتجات الحديد والصلب\",\"russianName\":\"Продукция из железа и стали\",\"turkishName\":\"Demir ve Çelik Ürünleri\",\"finnishName\":\"Rauta- ja terästuotteet\",\"urduName\":\"لوہے اور اسٹیل کی مصنوعات\",\"slug\":\"iron-steel-products\",\"imageUrl\":\"/images/categories/iron.webp\",\"icon\":\"beam\",\"unit\":\"kg\",\"isOrderable\":false,\"isActive\":true,\"sortOrder\":3,\"homepageSortOrder\":null,\"level\":2,\"isLeaf\":false,\"translations\":{\"ar\":{\"name\":\"منتجات الحديد والصلب\",\"metaTitle\":\"سوق منتجات الحديد والصلب بالجملة\",\"metaDescription\":\"سوق دولي للأعمال بين الشركات لتجارة منتجات الحديد والصلب بالجملة، يربط الموردين والمصنعين والمصدرين والمستوردين والمشترين.\"},\"en\":{\"name\":\"Iron & Steel Products\",\"metaTitle\":\"Iron & Steel Products Wholesale Marketplace\",\"metaDescription\":\"International B2B wholesale marketplace for Iron & Steel Products, connecting verified suppliers, manufacturers, exporters, importers and buyers.\"},\"fa\":{\"name\":\"محصولات آهن و فولاد\",\"metaTitle\":\"خرید و فروش عمده محصولات آهن و فولاد\",\"metaDesc