            "text": "{\"success\":true,\"data\":[{\"id\":10561,\"parentId\":10560,\"name\":\"لوازم خانه، آشپزخانه و حیوانات خانگی\",\"englishName\":\"Home, Kitchen & Pet Supplies\",\"arabicName\":\"مستلزمات المنزل والمطبخ والحيوانات الأليفة\",\"russianName\":\"Товары для дома, кухни и домашних животных\",\"turkishName\":\"Ev, Mutfak ve Evcil Hayvan Ürünleri\",\"finnishName\":\"Koti-, keittiö- ja lemmikkitarvikkeet\",\"urduName\":\"گھر، باورچی خانے اور پالتو جانوروں کا سامان\",\"slug\":\"home-kitchen-pet-supplies\",\"imageUrl\":\"/images/categories/home-kitchen-and-cleaning-supplies.webp\",\"icon\":\"sparkles\",\"unit\":\"piece\",\"isOrderable\":false,\"isActive\":true,\"sortOrder\":1,\"homepageSortOrder\":null,\"level\":2,\"isLeaf\":false,\"translations\":{\"ar\":{\"name\":\"مستلزمات المنزل والمطبخ والحيوانات الأليفة\",\"metaTitle\":\"سوق مستلزمات المنزل والمطبخ والحيوانات الأليفة بالجملة\",\"metaDescription\":\"سوق دولي للأعمال بين الشركات لتجارة مستلزمات المنزل والمطبخ والحيوانات الأليفة بالجملة، يربط الموردين والمصنعين والمصدرين والمستوردين والمشترين.\"},\"en\":{\"name\":\"Home, Kitchen & Pet Supplies\",\"metaTitle\":\"Home, Kitchen & Pet Supplies Wholesale Marketplace\",\"metaDescription\":\"International B2B wholesale marketplace for Home, Kitchen & Pet Supplies, connecting verified suppliers, manufacturers, exporters, importers and buyers.\"},\"fa\":{\"name\":\"لوازم خانه، آشپزخانه و حیوانات خانگی\",\"metaTitle\":\"خرید و فروش عمده لوازم خانه، آشپزخانه و حیوانات خانگی\",\"metaDescription\":\"بازار بین‌المللی B2B برای خرید و فروش عمده لوازم خانه، آشپزخانه و حیوانات خانگی؛ ویژه تأمین‌کنندگان، تولیدکنندگان، صادرکنندگان، واردکنندگان و خریداران.\"},\"fi\":{\"name\":\"Koti-, keittiö- ja lemmikkitarvikkeet\",\"metaTitle\":\"Koti-, keittiö- ja lemmikkitarvikkeet – tukkukauppa\",\"metaDescription\":\"Kansainvälinen B2B-tukkumarkkinapaikka tuoteryhmälle ”Koti-, keittiö- ja lemmikkitarvikkeet”, joka yhdistää toimittajat, valmistajat, viejät, maahantuojat ja…\"},\"ru\":{\