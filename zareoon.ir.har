            "text": "{\"success\":true,\"data\":[{\"id\":10593,\"parentId\":10592,\"name\":\"پوشاک\",\"englishName\":\"Apparel\",\"arabicName\":\"ملابس\",\"russianName\":\"Одежда\",\"turkishName\":\"Giyim\",\"finnishName\":\"Vaatteet\",\"urduName\":\"ملبوسات\",\"slug\":\"apparel\",\"imageUrl\":\"/images/categories/apparel.webp\",\"icon\":\"shirt\",\"unit\":\"kg\",\"isOrderable\":false,\"isActive\":true,\"sortOrder\":1,\"homepageSortOrder\":null,\"level\":2,\"isLeaf\":false,\"translations\":{\"ar\":{\"name\":\"ملابس\",\"metaTitle\":\"سوق ملابس بالجملة\",\"metaDescription\":\"سوق دولي للأعمال بين الشركات لتجارة ملابس بالجملة، يربط الموردين والمصنعين والمصدرين والمستوردين والمشترين.\"},\"en\":{\"name\":\"Apparel\",\"metaTitle\":\"Apparel Wholesale Marketplace\",\"metaDescription\":\"International B2B wholesale marketplace for Apparel, connecting verified suppliers, manufacturers, exporters, importers and buyers.\"},\"fa\":{\"name\":\"پوشاک\",\"metaTitle\":\"خرید و فروش عمده پوشاک\",\"metaDescription\":\"بازار بین‌المللی B2B برای خرید و فروش عمده پوشاک؛ ویژه تأمین‌کنندگان، تولیدکنندگان، صادرکنندگان، واردکنندگان و خریداران.\"},\"fi\":{\"name\":\"Vaatteet\",\"metaTitle\":\"Vaatteet – tukkukauppa\",\"metaDescription\":\"Kansainvälinen B2B-tukkumarkkinapaikka tuoteryhmälle ”Vaatteet”, joka yhdistää toimittajat, valmistajat, viejät, maahantuojat ja ostajat.\"},\"ru\":{\"name\":\"Одежда\",\"metaTitle\":\"Одежда — оптовая торговля\",\"metaDescription\":\"Международная B2B-площадка для оптовой торговли в категории «Одежда», объединяющая поставщиков, производителей, экспортёров, импортёров и покупателей.\"},\"tr\":{\"name\":\"Giyim\",\"metaTitle\":\"Toptan Giyim Pazarı\",\"metaDescription\":\"Tedarikçileri, üreticileri, ihracatçıları, ithalatçıları ve alıcıları buluşturan Giyim kategorisine yönelik uluslararası B2B toptan ticaret pazaryeri.\"},\"ur\":{\"name\":\"ملبوسات\",\"metaTitle\":\"ملبوسات کی تھوک مارکیٹ\",\"metaDescription\":\"ملبوسات کی تھوک تجارت کے لیے بین الاقوامی B2B مارکیٹ پلیس، جو سپلائرز، مینوفیکچررز، برآمد کنندگان، درآمد کنندگان اور خریداروں کو جوڑتی ہے۔\"}}},{\"id\":10601,\"parentId\":10592,\"name\":\"نساجی و مواد اولیه\",\"englishName\":\"Textiles & Raw Materials\",\"arabicName\":\"المنسوجات والمواد الخام\",\"russianName\":\"Текстиль и сырьё\",\"turkishName\":\"Tekstil ve Hammaddeler\",\"finnishName\":\"Tekstiilit ja raaka-aineet\",\"urduName\":\"ٹیکسٹائل اور خام مال\",\"slug\":\"textiles-and-raw-materials\",\"imageUrl\":\"/images/categories/textiles-and-raw-materials.webp\",\"icon\":\"scissors\",\"unit\":\"kg\",\"isOrderable\":false,\"isActive\":true,\"sortOrder\":2,\"homepageSortOrder\":null,\"level\":2,\"isLeaf\":false,\"translations\":{\"ar\":{\"name\":\"المنسوجات والمواد الخام\",\"metaTitle\":\"سوق المنسوجات والمواد الخام بالجملة\",\"metaDescription\":\"سوق دولي للأعمال بين الشركات لتجارة المنسوجات والمواد الخام بالجملة، يربط الموردين والمصنعين والمصدرين والمستوردين والمشترين.\"},\"en\":{\"name\":\"Textiles & Raw Materials\",\"metaTitle\":\"Textiles & Raw Materials Wholesale Marketplace\",\"metaDescription\":\"International B2B wholesale marketplace for Textiles & Raw Materials, connecting verified suppliers, manufacturers, exporters, importers and buyers.\"},\"fa\":{\"name\":\"نساجی و مواد اولیه\",\"metaTitle\":\"خرید و فروش عمده نساجی و مواد اولیه\",\"metaDescription\":\"بازار بین‌المللی B2B برای خرید و فروش عمده نساجی و مواد اولیه؛ ویژه تأمین‌کنندگان، تولیدکنندگان، صادرکنندگان، واردکنندگان و خریداران.\"},\"fi\":{\"name\":\"Tekstiilit ja raaka-aineet\",\"metaTitle\":\"Tekstiilit ja raaka-aineet – tukkukauppa\",\"metaDescription\":\"Kansainvälinen B2B-tukkumarkkinapaikka tuoteryhmälle ”Tekstiilit ja raaka-aineet”, joka yhdistää toimittajat, valmistajat, viejät, maahantuojat ja ostajat.\"},\"ru\":{\"name\":\"Текстиль и сырьё\",\"metaTitle\":\"Текстиль и сырьё — оптовая торговля\",\"metaDescription\":\"Международная B2B-площадка для оптовой торговли в категории «Текстиль и сырьё», объединяющая поставщиков, производителей, экспортёров, импортёров и покупателей.\"},\"tr\":{\"name\":\"Tekstil ve Hammaddeler\",\"metaTitle\":\"Toptan Tekstil ve Hammaddeler Pazarı\",\"metaDescription\":\"Tedarikçileri, üreticileri, ihracatçıları, ithalatçıları ve alıcıları buluşturan Tekstil ve Hammaddeler kategorisine yönelik uluslararası B2B toptan ticaret…\"},\"ur\":{\"name\":\"ٹیکسٹائل اور خام مال\",\"metaTitle\":\"ٹیکسٹائل اور خام مال کی تھوک مارکیٹ\",\"metaDescription\":\"ٹیکسٹائل اور خام مال کی تھوک تجارت کے لیے بین الاقوامی B2B مارکیٹ پلیس، جو سپلائرز، مینوفیکچررز، برآمد کنندگان، درآمد کنندگان اور خریداروں کو جوڑتی ہے۔\"}}},{\"id\":10608,\"parentId\":10592,\"name\":\"اکسسوری و محصولات مد\",\"englishName\":\"Fashion Accessories\",\"arabicName\":\"إكسسوارات الموضة\",\"russianName\":\"Модные аксессуары\",\"turkishName\":\"Moda Aksesuarları\",\"finnishName\":\"Muotiasusteet\",\"urduName\":\"فیشن لوازمات\",\"slug\":\"fashion-accessories\",\"imageUrl\":\"/images/categories/fashion-accessories.webp\",\"icon\":\"tag\",\"unit\":\"kg\",\"isOrderable\":false,\"isActive\":true,\"sortOrder\":3,\"homepageSortOrder\":null,\"level\":2,\"isLeaf\":false,\"translations\":{\"ar\":{\"name\":\"إكسسوارات الموضة\",\"metaTitle\":\"سوق إكسسوارات الموضة بالجملة\",\"metaDescription\":\"سوق دولي للأعمال بين الشركات لتجارة إكسسوارات الموضة بالجملة، يربط الموردين والمصنعين والمصدرين والمستوردين والمشترين.\"},\"en\":{\"name\":\"Fashion Accessories\",\"metaTitle\":\"Fashion Accessories Wholesale Marketplace\",\"metaDescription\":\"International B2B wholesale marketplace for Fashion Accessories, connecting verified suppliers, manufacturers, exporters, importers and buyers.\"},\"fa\":{\"name\":\"اکسسوری و محصولات مد\",\"metaTitle\":\"خرید و فروش عمده اکسسوری و محصولات مد\",\"metaDescription\":\"بازار بین‌المللی B2B برای خرید و فروش عمده اکسسوری و محصولات مد؛ ویژه تأمین‌کنندگان، تولیدکنندگان، صادرکنندگان، واردکنندگان و خریداران.\"},\"fi\":{\"name\":\"Muotiasusteet\",\"metaTitle\":\"Muotiasusteet – tukkukauppa\",\"metaDescription\":\"Kansainvälinen B2B-tukkumarkkinapaikka tuoteryhmälle ”Muotiasusteet”, joka yhdistää toimittajat, valmistajat, viejät, maahantuojat ja ostajat.\"},\"ru\":{\"name\":\"Модные аксессуары\",\"metaTitle\":\"Модные аксессуары — оптовая торговля\",\"metaDescription\":\"Международная B2B-площадка для оптовой торговли в категории «Модные аксессуары», объединяющая поставщиков, производителей, экспортёров, импортёров и…\"},\"tr\":{\"name\":\"Moda Aksesuarları\",\"metaTitle\":\"Toptan Moda Aksesuarları Pazarı\",\"metaDescription\":\"Tedarikçileri, üreticileri, ihracatçıları, ithalatçıları ve alıcıları buluşturan Moda Aksesuarları kategorisine yönelik uluslararası B2B toptan ticaret…\"},\"ur\":{\"name\":\"فیشن لوازمات\",\"metaTitle\":\"فیشن لوازمات کی تھوک مارکیٹ\",\"metaDescription\":\"فیشن لوازمات کی تھوک تجارت کے لیے بین الاقوامی B2B مارکیٹ پلیس، جو سپلائرز، مینوفیکچررز، برآمد کنندگان، درآمد کنندگان اور خریداروں کو جوڑتی ہے۔\"}}},{\"id\":10615,\"parentId\":10592,\"name\":\"ساعت، زیورآلات و عینک\",\"englishName\":\"Watches, Jewelry & Eyewear\",\"arabicName\":\"الساعات والمجوهرات والنظارات\",\"russianName\":\"Часы, ювелирные изделия и очки\",\"turkishName\":\"Saat, Takı ve Gözlük\",\"finnishName\":\"Kellot, korut ja silmälasit\",\"urduName\":\"گھڑیاں، زیورات اور چشمے\",\"slug\":\"watches-jewelry-and-eyewear\",\"imageUrl\":\"/images/categories/watches-jewelry-and-eyewear.webp\",\"icon\":\"tag\",\"unit\":\"kg\",\"isOrderable\":false,\"isActive\":true,\"sortOrder\":4,\"homepageSortOrder\":null,\"level\":2,\"isLeaf\":false,\"translations\":{\"ar\":{\"name\":\"الساعات والمجوهرات والنظارات\",\"metaTitle\":\"سوق الساعات والمجوهرات والنظارات بالجملة\",\"metaDescription\":\"سوق دولي للأعمال بين الشركات لتجارة الساعات والمجوهرات والنظارات بالجملة، يربط الموردين والمصنعين والمصدرين والمستوردين والمشترين.\"},\"en\":{\"name\":\"Watches, Jewelry & Eyewear\",\"metaTitle\":\"Watches, Jewelry & Eyewear Wholesale Marketplace\",\"metaDescription\":\"International B2B wholesale marketplace for Watches, Jewelry & Eyewear, connecting verified suppliers, manufacturers, exporters, importers and buyers.\"},\"fa\":{\"name\":\"ساعت، زیورآلات و عینک\",\"metaTitle\":\"خرید و فروش عمده ساعت، زیورآلات و عینک\",\"metaDescription\":\"بازار بین‌المللی B2B برای خرید و فروش عمده ساعت، زیورآلات و عینک؛ ویژه تأمین‌کنندگان، تولیدکنندگان، صادرکنندگان، واردکنندگان و خریداران.\"},\"fi\":{\"name\":\"Kellot, korut ja silmälasit\",\"metaTitle\":\"Kellot, korut ja silmälasit – tukkukauppa\",\"metaDescription\":\"Kansainvälinen B2B-tukkumarkkinapaikka tuoteryhmälle ”Kellot, korut ja silmälasit”, joka yhdistää toimittajat, valmistajat, viejät, maahantuojat ja ostajat.\"},\"ru\":{\"name\":\"Часы, ювелирные изделия и очки\",\"metaTitle\":\"Часы, ювелирные изделия и очки — оптовая торговля\",\"metaDescription\":\"Международная B2B-площадка для оптовой торговли в категории «Часы, ювелирные изделия и очки», объединяющая поставщиков, производителей, экспортёров, импортёров…\"},\"tr\":{\"name\":\"Saat, Takı ve Gözlük\",\"metaTitle\":\"Toptan Saat, Takı ve Gözlük Pazarı\",\"metaDescription\":\"Tedarikçileri, üreticileri, ihracatçıları, ithalatçıları ve alıcıları buluşturan Saat, Takı ve Gözlük kategorisine yönelik uluslararası B2B toptan ticaret…\"},\"ur\":{\"name\":\"گھڑیاں، زیورات اور چشمے\",\"metaTitle\":\"گھڑیاں، زیورات اور چشمے کی تھوک مارکیٹ\",\"metaDescription\":\"گھڑیاں، زیورات اور چشمے کی تھوک تجارت کے لیے بین الاقوامی B2B مارکیٹ پلیس، جو سپلائرز، مینوفیکچررز، برآمد کنندگان، درآمد کنندگان اور خریداروں کو جوڑتی ہے۔\"}}}],\"meta\":{\"count\":4,\"limit\":null,\"q\":null}}"
