{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "zareoon-reserved-usernames",
  "version": "1.0.0",
  "description": "Reserved slugs and username validation configuration for root-level public profiles.",
  "normalization": {
    "lowercase": true,
    "trim": true,
    "unicodeNormalization": "NFKC",
    "replaceSpacesWith": "-",
    "collapseRepeatedHyphens": true
  },
  "validation": {
    "minLength": 3,
    "maxLength": 30,
    "allowedPattern": "^[a-z0-9](?:[a-z0-9-]{1,28}[a-z0-9])?$",
    "forbidNumericOnly": true,
    "forbidIpAddress": true,
    "forbidEmailLike": true,
    "forbidUuid": true,
    "forbidFileExtensions": true,
    "forbidLeadingOrTrailingHyphen": true,
    "forbidConsecutiveHyphens": true,
    "caseInsensitive": true
  },
